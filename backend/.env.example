PORT=3000
BACKEND_PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-secure-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
DATABASE_PATH=./database/trustbridge.db

# Optional development-only demo seeding (disabled by default; forbidden in production)
ENABLE_DEMO_SEED=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
DEMO_SELLER_EMAIL=
DEMO_SELLER_PASSWORD=

# Backend-only administrator provisioning script variables (npm run provision:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

TRANSLATION_PROVIDER=none
TRANSLATION_API_URL=
TRANSLATION_API_KEY=

# Nexconn Chat SDK configuration (backend-only App Secret)
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_AREA_CODE=SG
